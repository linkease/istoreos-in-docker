#!/bin/sh /etc/rc.common

# After network
START=21

start() {
	br=dsm-br
	vnet1=dsm-int
	vnet2=dsm-ext
	curl -H "Content-Type: application/json" -X POST \
		-d '{"br":"'$br'","vnet1":"'$vnet1'","vnet2":"'$vnet2'"}' \
		--fail --max-time 15 --unix-socket /host/run/vmease/daemon.sock \
		"http://localhost/api/vmease/create-br/"
}

